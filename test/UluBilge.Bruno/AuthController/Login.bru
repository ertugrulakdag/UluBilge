meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/v1/Auth/Login
  body: json
  auth: inherit
}

body:json {
  {
    "userName": "admin",
    "password": "admin"
  }
}

tests {
  const body = res.getBody();
  const json = typeof body === "string" ? JSON.parse(body) : body;
  
  const accessToken = json?.data?.accessToken;
  if (!accessToken){
    throw new Error("Token yok");
  } 
  
  bru.setEnvVar("accessToken", accessToken);
}

settings {
  encodeUrl: true
  timeout: 0
}
