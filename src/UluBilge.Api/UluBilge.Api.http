@UluBilge.Api_HostAddress = https://localhost:7187
@accessToken = paste-access-token-here

### Development mock login: copy accessToken from the response into the variable above.

POST {{UluBilge.Api_HostAddress}}/v1/Auth/login
Content-Type: application/json

{
  "userName": "admin",
  "password": "admin"
}

###

GET {{UluBilge.Api_HostAddress}}/v1/Auth/me
Authorization: Bearer {{accessToken}}
Accept: application/json

###

GET {{UluBilge.Api_HostAddress}}/v1/Region/GetRegions?pageNumber=1&pageSize=20
Authorization: Bearer {{accessToken}}
Accept: application/json

###

GET {{UluBilge.Api_HostAddress}}/v1/Region/GetRegion/1
Authorization: Bearer {{accessToken}}
Accept: application/json

###

POST {{UluBilge.Api_HostAddress}}/v1/Region/Add
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "regionId": 5,
  "regionDescription": "Marmara"
}

###

PUT {{UluBilge.Api_HostAddress}}/v1/Region/Update
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "regionId": 5,
  "regionDescription": "Marmara Bölgesi"
}

###

DELETE {{UluBilge.Api_HostAddress}}/v1/Region/Delete/5
Authorization: Bearer {{accessToken}}
Accept: application/json

###
