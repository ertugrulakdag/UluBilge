<Project Sdk="Microsoft.NET.Sdk"> <!-- // OAuth entegrasyon test projesini tanimlar. -->
  <PropertyGroup> <!-- // Test derleme ayarlarini gruplar. -->
    <TargetFramework>net10.0</TargetFramework> <!-- // API ile ayni .NET surumunu kullanir. -->
    <ImplicitUsings>enable</ImplicitUsings> <!-- // Standart ad alanlarini otomatik ekler. -->
    <Nullable>enable</Nullable> <!-- // Null denetimlerini etkinlestirir. -->
    <IsPackable>false</IsPackable> <!-- // Test projesinin paketlenmesini engeller. -->
    <IsTestProject>true</IsTestProject> <!-- // Projeyi test calistiricilarina tanitir. -->
  </PropertyGroup> <!-- // Test derleme ayarlarini tamamlar. -->
  <ItemGroup> <!-- // Test altyapisi paketlerini gruplar. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" /> <!-- // Gercek ASP.NET Core HTTP akislarini bellek icinde test eder. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" /> <!-- // Test sunucusunun dolayli kriptografi bagimliligini duzeltilmis surume sabitler. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" /> <!-- // Test sunucusunun XML kriptografi bagimliligini duzeltilmis surume sabitler. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" /> <!-- // Dotnet test komutunun testleri calistirmasini saglar. -->
    <PackageReference Include="xunit" Version="2.9.3" /> <!-- // Test senaryolarini ve beklentilerini tanimlar. -->
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" /> <!-- // XUnit testlerini Visual Studio ve dotnet test ile calistirir. -->
  </ItemGroup> <!-- // Test paketlerini tamamlar. -->
  <ItemGroup> <!-- // Test edilen projeyi gruplar. -->
    <ProjectReference Include="../../src/UluBilge.Api/UluBilge.Api.csproj" /> <!-- // Gercek API ve OAuth uygulamasini test projesine baglar. -->
  </ItemGroup> <!-- // Proje baglantisini tamamlar. -->
</Project> <!-- // Test projesini tamamlar. -->
